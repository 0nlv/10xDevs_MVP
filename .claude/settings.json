{
  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Read",
      "Edit",
      "Write"
    ],
    "ask": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push *)",
      "Bash(git push)"
    ],
    "deny": [
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "afterEdit": [
      {
        "name": "ESLint Check",
        "command": "npm run lint",
        "exitCodeBehavior": {
          "0": "continue",
          "2": "block"
        }
      },
      {
        "name": "TypeScript Type Check",
        "command": "npx tsc --noEmit",
        "exitCodeBehavior": {
          "0": "continue",
          "2": "block"
        }
      }
    ]
  }
}