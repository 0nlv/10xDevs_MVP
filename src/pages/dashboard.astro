---
import Layout from "@/layouts/Layout.astro";
import AlertsDashboard from "@/components/dashboard/AlertsDashboard";

const { user } = Astro.locals;
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-6xl py-8">
      <!-- Header -->
      <div class="mb-8 flex items-center justify-between">
        <div>
          <h1 class="mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-4xl font-bold text-transparent">
            ProfitLeak Dashboard
          </h1>
          <p class="text-blue-100/80">
            Witaj, <span class="font-semibold text-white">{user?.email}</span>
          </p>
        </div>
      </div>

      <!-- Main Dashboard -->
      <div class="mb-8">
        <AlertsDashboard client:load />
      </div>

      <!-- Quick Actions -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        <a
          href="/uploads"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-3 text-sm transition-colors hover:bg-white/20 text-center"
        >
          📂 Zarządzanie danymi
          <span class="block text-xs text-blue-100/60 mt-1">Przeglądaj i usuwaj wgrane pliki</span>
        </a>
        
        <a
          href="/transactions"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-3 text-sm transition-colors hover:bg-white/20 text-center"
        >
          💰 Transakcje
          <span class="block text-xs text-blue-100/60 mt-1">Edytuj dane transakcji</span>
        </a>
        
        <a
          href="/onboarding/step-1"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-3 text-sm transition-colors hover:bg-white/20 text-center"
        >
          ➕ Wgraj nowe dane
          <span class="block text-xs text-blue-100/60 mt-1">Dodaj pliki CSV</span>
        </a>
      </div>

      <!-- Footer -->
      <div class="flex justify-center">
        <form method="POST" action="/api/auth/signout">
          <button
            type="submit"
            class="rounded-lg border border-white/20 bg-white/10 px-6 py-2 text-sm transition-colors hover:bg-white/20"
          >
            Wyloguj się
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>
