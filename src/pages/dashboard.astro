---
import Layout from "@/layouts/Layout.astro";

const { user } = Astro.locals;
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl max-w-md w-full">
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent text-center">
        Dashboard
      </h1>
      <p class="text-blue-100/80 text-center mb-6">
        Witaj, <span class="font-semibold text-white">{user?.email}</span>
      </p>
      
      <div class="space-y-3 mb-6">
        <a
          href="/uploads"
          class="block w-full rounded-lg border border-white/20 bg-white/10 px-4 py-3 text-sm transition-colors hover:bg-white/20 text-center"
        >
          📂 Zarządzanie danymi
          <span class="block text-xs text-blue-100/60 mt-1">Przeglądaj i usuwaj wgrane pliki</span>
        </a>
        
        <a
          href="/transactions"
          class="block w-full rounded-lg border border-white/20 bg-white/10 px-4 py-3 text-sm transition-colors hover:bg-white/20 text-center"
        >
          💰 Transakcje
          <span class="block text-xs text-blue-100/60 mt-1">Edytuj dane transakcji</span>
        </a>
        
        <a
          href="/onboarding/step-1"
          class="block w-full rounded-lg border border-white/20 bg-white/10 px-4 py-3 text-sm transition-colors hover:bg-white/20 text-center"
        >
          ➕ Wgraj nowe dane
          <span class="block text-xs text-blue-100/60 mt-1">Dodaj pliki CSV</span>
        </a>
      </div>
      
      <form method="POST" action="/api/auth/signout" class="mt-6">
        <button
          type="submit"
          class="w-full rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Wyloguj się
        </button>
      </form>
    </div>
  </div>
</Layout>
